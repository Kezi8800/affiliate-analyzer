function normalize(value) {
  return String(value || "")
    .toLowerCase()
    .trim();
}

function matchInternationalPublisher(input = "") {
  const haystack = normalize(input);

  if (!haystack) return null;

  for (const rule of INTERNATIONAL_PUBLISHER_RULES) {
    if (rule.patterns.some(pattern => haystack.includes(normalize(pattern)))) {
      return {
        publisher: rule.publisher,
        region: rule.region,
        market: rule.market,
        type: rule.type,
        subtype: rule.subtype,
        media_group: rule.media_group,
        confidence: rule.confidence || "Medium",
        matched_by: "international_publisher_rules",
        matched_pattern: rule.patterns.find(pattern => haystack.includes(normalize(pattern))) || null
      };
    }
  }

  return null;
}

function matchInternationalPublisherFromUrl(urlObj, params = {}) {
  const parts = [
    urlObj?.hostname,
    urlObj?.pathname,
    urlObj?.search,
    params.utm_source,
    params.utm_medium,
    params.utm_campaign,
    params.utm_content,
    params.utm_term,
    params.aff,
    params.affname,
    params.publisher,
    params.publisherid,
    params.source,
    params.ref,
    params.tag,
    params.ascsubtag,
    params.sharedId,
    params.subId1,
    params.subId2,
    params.subId3
  ]
    .filter(Boolean)
    .join(" ");

  return matchInternationalPublisher(parts);
}

